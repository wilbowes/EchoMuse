#!/system/bin/sh
# em-wifi — set the device's WiFi from the USB console.
#
# The console is the only channel left when the network is the broken thing,
# so this works with nothing but a serial terminal: scan, pick a number, type
# a password, and it waits to see the device actually join.
#
# It writes emOS's own /data/emos/wpa.conf and NOT Android's file, on purpose
# -- see wpa_conf() in init.c. Anything under /data/misc/wifi belongs to
# whichever OS booted last, and FireOS 6 rewrites it.
set -u
CONF=/data/emos/wpa.conf
ANDROID_CONF=/data/misc/wifi/wpa_supplicant.conf
CLI=/sbin/wpa_cli
SUP=/sbin/wpa_supplicant

[ -x "$CLI" ] || { echo "em-wifi: $CLI is missing (older image?)"; exit 1; }

# READ from the conf the supplicant is running on, never assumed -- same rule
# and same two spellings as wpa_ctrl_dir() in init.c and sockDir() in
# internal/wifi.
#
# It matters most on a device migrated from FireOS 5, which carries Android's
# conf: init starts a supplicant on it, pgrep below finds one, and a wpa_cli
# pointed at /data/emos/sockets reaches nothing. This used to report "No networks
# found. Is the radio up?" on a device that was up and associated.
ctrl_from_conf() {
    [ -r "$1" ] || return 1
    awk '
        /^[ \t]*ctrl_interface=/ {
            sub(/^[ \t]*ctrl_interface=/, "")
            sub(/^DIR=/, "")
            sub(/[ \t].*$/, "")
            if ($0 ~ /^\//) d = $0     # last wins, as in hostap
        }
        END { if (d != "") print d }
    ' "$1"
}

# Pick the conf init would have used -- wpa_conf() -- and read only that one.
# Consulting both in turn would disagree with init on a conf declaring no
# ctrl_interface, where init falls back to Android's directory.
ACTIVE=
[ -r "$CONF" ] && ACTIVE=$CONF
[ -z "$ACTIVE" ] && [ -r "$ANDROID_CONF" ] && ACTIVE=$ANDROID_CONF

if [ -n "$ACTIVE" ]; then
    CTRL=$(ctrl_from_conf "$ACTIVE" || true)
    # init's own default, for a conf that declares nothing usable.
    [ -n "$CTRL" ] || CTRL=/data/misc/wifi/sockets
else
    # No conf at all: nothing to preserve, and this is a first-time setup. emOS's
    # own directory is ours to create, unlike /data/misc/wifi on a device that
    # has never booted Android.
    CTRL=/data/emos/sockets
fi

# Scanning needs a running supplicant. If none is up -- which is the normal
# state on an unprovisioned device, where init is waiting for a conf -- start
# one on a throwaway config; we want its radio, not its networks.
if ! pgrep wpa_supplicant >/dev/null 2>&1; then
    mkdir -p "$CTRL"
    printf 'ctrl_interface=%s\nupdate_config=1\n' "$CTRL" > /tmp/em-wifi-scan.conf
    "$SUP" -iwlan0 -Dnl80211 -c/tmp/em-wifi-scan.conf -B >/dev/null 2>&1
    sleep 2
fi

echo "Scanning..."
"$CLI" -p "$CTRL" -iwlan0 scan >/dev/null 2>&1
sleep 4

# Strongest first, one entry per SSID, hidden (all-zero) and unnamed dropped.
#
# An SSID is any 0-32 bytes, so it is carried as HEX from here on and written
# to the conf that way: nothing in it can then break the conf or this script.
# scan_results is TAB-separated and prints the SSID through hostap's
# printf_encode (`"` and `\` escaped, \e \n \r \t, \xNN for anything else
# outside 0x20-0x7e); ssid_hex() reverses that. Splitting on whitespace
# instead cut "My Home WiFi" to "My". Mirrors _wpaUnescape in the dashboard
# and UnescapeSSID in the firmware. Columns out: signal, flags, hex, name as
# wpa_cli prints it (escapes and all -- it is only shown).
"$CLI" -p "$CTRL" -iwlan0 scan_results 2>/dev/null | awk '
    BEGIN { FS = "\t"; for (i = 32; i < 127; i++) ord[sprintf("%c", i)] = i }
    function ssid_hex(s,    out, i, c, n, h) {
        out = ""
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "\\" && i < length(s)) {
                n = substr(s, i + 1, 1); h = substr(s, i + 2, 2)
                if (n == "x" && h ~ /^[0-9a-fA-F][0-9a-fA-F]$/) { out = out tolower(h); i += 3; continue }
                if (n == "\\") { out = out "5c"; i++; continue }
                if (n == "\"")  { out = out "22"; i++; continue }
                if (n == "e")   { out = out "1b"; i++; continue }
                if (n == "n")   { out = out "0a"; i++; continue }
                if (n == "r")   { out = out "0d"; i++; continue }
                if (n == "t")   { out = out "09"; i++; continue }
            }
            out = out sprintf("%02x", ord[c])
        }
        return out
    }
    NR > 1 && NF >= 5 {
        name = $5; sub(/\r$/, "", name)
        h = ssid_hex(name)
        if (h == "" || h ~ /^(00)+$/ || seen[h]++) next
        printf "%s\t%s\t%s\t%s\n", $3, $4, h, name
    }' | sort -rn | head -20 > /tmp/em-wifi-list

if [ ! -s /tmp/em-wifi-list ]; then
    echo "No networks found. Is the radio up? See /run/net.log."
    exit 1
fi

echo ""
n=0
while IFS="$(printf '\t')" read -r sig flags hex ssid; do
    n=$((n + 1))
    case "$flags" in
        *SAE*) note=" (WPA3 - not supported)" ;;
        *PSK*) note="" ;;
        *WEP*) note=" (WEP - not supported)" ;;
        *)     note=" (open)" ;;
    esac
    printf '%2d) %-32s %4s dBm%s\n' "$n" "$ssid" "$sig" "$note"
done < /tmp/em-wifi-list
echo ""

printf 'Number (or q to quit): '
read choice
case "$choice" in
    q|Q|"") echo "Cancelled."; exit 0 ;;
esac

line=$(sed -n "${choice}p" /tmp/em-wifi-list)
[ -n "$line" ] || { echo "No such entry."; exit 1; }
flags=$(printf '%s\n' "$line" | cut -f2)
ssid_hex=$(printf '%s\n' "$line" | cut -f3)
ssid=$(printf '%s\n' "$line" | cut -f4)

case "$flags" in
    *SAE*)
        echo "$ssid is WPA3, which this device cannot join. Its driver does"
        echo "not do SAE and the kernel is too old to let us do it instead."
        exit 1 ;;
esac

case "$flags" in
    *PSK*)
        printf 'Password for %s: ' "$ssid"
        # -r: a backslash in a password is a backslash. IFS= keeps leading
        # and trailing spaces, which a passphrase may have.
        IFS= read -r psk
        # WPA2 allows 8-63 printable ASCII characters, or 64 hex digits.
        if printf '%s' "$psk" | grep -Eq '^[0-9a-fA-F]{64}$'; then
            psk_line="psk=$psk"
        elif printf '%s\n' "$psk" | awk '{ exit !(length($0) >= 8 && length($0) <= 63 && $0 !~ /[^ -~]/) }'; then
            # Quoted, and needing no escaping: wpa_supplicant ends a quoted
            # passphrase at its LAST double quote, so `"` and `\` inside it
            # are literal (wpa_config_parse_psk).
            psk_line="psk=\"$psk\""
        else
            echo "A WiFi password is 8-63 printable characters (letters, digits,"
            echo "spaces and punctuation), or 64 hex digits."
            exit 1
        fi
        keymgmt="WPA-PSK" ;;
    *)
        psk_line=""
        keymgmt="NONE" ;;
esac

mkdir -p /data/emos
# printf '%s', never echo: nothing in a password may be read as an escape.
{
    printf 'ctrl_interface=%s\n' "$CTRL"
    printf 'update_config=1\n'
    printf 'network={\n'
    printf '        ssid=%s\n' "$ssid_hex"
    [ -n "$psk_line" ] && printf '        %s\n' "$psk_line"
    printf '        key_mgmt=%s\n' "$keymgmt"
    printf '}\n'
} > "$CONF"
chmod 600 "$CONF"
echo "Wrote $CONF."

# init supervises the supplicant and restarts it against whatever conf is
# there, so all this does is retire the old process and watch for an address.
killall wpa_supplicant 2>/dev/null
echo "Connecting..."
i=0
while [ $i -lt 40 ]; do
    if [ "$(cat /sys/class/net/wlan0/carrier 2>/dev/null)" = "1" ]; then
        addr=$(ip addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p')
        if [ -n "$addr" ]; then
            echo "Connected to $ssid as $addr."
            exit 0
        fi
    fi
    sleep 2
    i=$((i + 1))
done

echo "No address after 80s. See /run/net.log."
exit 1
